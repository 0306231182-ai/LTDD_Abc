<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvResultHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Đã nộp bài"
        android:textColor="#203B62"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvResultSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Bạn đã chọn đáp án cho 0/0 câu hỏi."
        android:textSize="17sp" />

    <TextView
        android:id="@+id/tvResultNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Đang chờ chấm điểm..."
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Về trang chủ" />
</LinearLayout>
