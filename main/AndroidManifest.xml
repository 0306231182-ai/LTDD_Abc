<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoAn">

        <!-- Màn hình khởi động: kiểm tra đã đăng nhập chưa -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Đăng nhập / đăng ký -->
        <activity
            android:name=".ui.auth.WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Sinh viên -->
        <activity
            android:name=".ui.student.StudentDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.ExamIntroActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.DoExamActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.ExamResultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.ResultActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.ExamHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.MyQuizzesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.student.ProfileActivity"
            android:exported="false" />

        <!-- Giáo viên -->
        <activity
            android:name=".ui.teacher.TeacherDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ui.teacher.QuizFormActivity"
            android:exported="false" />
        <activity
            android:name=".ui.teacher.QuestionFormActivity"
            android:exported="false" />
        <activity
            android:name=".ui.teacher.TeacherResultsActivity"
            android:exported="false" />

    </application>

</manifest>